<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <TransparentMaterials>
        <!-- HUD meter plate corner atlas: 4 quadrants with anti-aliased 45-degree chamfer alpha -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>CoopHudCorners</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <AlphaSaturation>1</AlphaSaturation>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <IgnoreDepth>false</IgnoreDepth>
            <SoftParticleDistanceScale>1</SoftParticleDistanceScale>
            <Texture>Textures\GUI\CoopHudCorners.dds</Texture>
            <UseAtlas>false</UseAtlas>
            <NeedSort>true</NeedSort>
            <UVOffset>
                <X>0</X>
                <Y>0</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
            <Color>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
                <W>1</W>
            </Color>
            <ColorAdd>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </ColorAdd>
            <ShadowMultiplier>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </ShadowMultiplier>
            <LightMultiplier>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </LightMultiplier>
        </TransparentMaterial>
        <!-- CAPMETER alert badge. Points at the VANILLA LCD "Danger" sprite (the orange warning
             triangle), so no art ships with the mod. Keep its own colours: the texture is
             orange+white, and tinting it would multiply into mud. -->
        <TransparentMaterial>
            <Id>
                <TypeId>TransparentMaterialDefinition</TypeId>
                <SubtypeId>CoopHudAlert</SubtypeId>
            </Id>
            <AlphaMistingEnable>false</AlphaMistingEnable>
            <AlphaSaturation>1</AlphaSaturation>
            <CanBeAffectedByOtherLights>false</CanBeAffectedByOtherLights>
            <IgnoreDepth>false</IgnoreDepth>
            <SoftParticleDistanceScale>1</SoftParticleDistanceScale>
            <Texture>Textures\Sprites\DangerZone.dds</Texture>
            <UseAtlas>false</UseAtlas>
            <NeedSort>true</NeedSort>
            <UVOffset>
                <X>1</X>
                <Y>1</Y>
            </UVOffset>
            <UVSize>
                <X>1</X>
                <Y>1</Y>
            </UVSize>
            <Color>
                <X>1</X>
                <Y>1</Y>
                <Z>1</Z>
                <W>1</W>
            </Color>
            <ColorAdd>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </ColorAdd>
            <ShadowMultiplier>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </ShadowMultiplier>
            <LightMultiplier>
                <X>0</X>
                <Y>0</Y>
                <Z>0</Z>
                <W>0</W>
            </LightMultiplier>
        </TransparentMaterial>
    </TransparentMaterials>
</Definitions>
